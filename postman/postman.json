{
	"info": {
		"_postman_id": "b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e",
		"name": "SMTrack API - Frontend",
		"description": "Postman collection mirroring the **frontend contract** for the SMTrack backend API.\n\nGrouped exactly like the React app (`src/features/*`): Auth, Dashboard, Trackers, Geofencing, Analytics, Notifications. Use this to reproduce any API call the UI makes — same headers, same bodies, same response shape the frontend expects (`{ success, data }` envelope).\n\n## Differences vs backend collection\n- Uses collection variable `email` / `password` (set to seeded admin by default) so you can swap users quickly.\n- Auth folder logs in and stores `accessToken` automatically — mirrors `useAuth` hook behaviour.\n- Tracker folder creates a tracker first and captures its `trackerId` for detail-page calls, like `TrackersPage` → `TrackerDetailPage` flow.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "smtrack-frontend"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:3001" },
		{ "key": "email", "value": "admin@smtrack.com" },
		{ "key": "password", "value": "admin123" },
		{ "key": "accessToken", "value": "" },
		{ "key": "refreshToken", "value": "" },
		{ "key": "userId", "value": "" },
		{ "key": "trackerId", "value": "" },
		{ "key": "geofenceId", "value": "" },
		{ "key": "notificationId", "value": "" }
	],
	"auth": {
		"type": "bearer",
		"bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
	},
	"item": [
		{
			"name": "0. Health",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"pm.test('API reachable', () => {",
									"    pm.expect(pm.response.json().status).to.eql('ok');",
									"});"
								]
							}
						}
					],
					"response": []
				}
			]
		},
		{
			"name": "1. Auth (AuthPage / useAuth)",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"pm.test('Store tokens like useAuth does', () => {",
									"    const body = pm.response.json();",
									"    pm.collectionVariables.set('accessToken', body.data.accessToken);",
									"    pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
									"    pm.collectionVariables.set('userId', body.data.user.id);",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"New User\",\n  \"role\": \"FIELD_ENGINEER\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": "pm.test('Status is 201', () => pm.response.to.have.status(201));"
							}
						}
					],
					"response": []
				},
				{
					"name": "Refresh Token (silent refresh)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
