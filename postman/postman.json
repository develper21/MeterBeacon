			"item": [
				{
					"name": "List Users (Admin/Manager)",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"pm.test('Capture userId if present', () => {",
									"    const body = pm.response.json();",
									"    if (body.data.length > 0) pm.collectionVariables.set('userId', body.data[0].id);",
									"});"
								]
							}
						}
					],
					"response": []
				},
				{
					"name": "Get User",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/users/:id", "host": ["{{baseUrl}}"], "path": ["api", "users", ":id"], "variable": [{ "key": "id", "value": "{{userId}}" }] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": "pm.test('Status is 200', () => pm.response.to.have.status(200));"
							}
						}
					],
					"response": []
				},
				{
					"name": "Update User",
					"request": {
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fullName\": \"Renamed User\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/users/:id", "host": ["{{baseUrl}}"], "path": ["api", "users", ":id"], "variable": [{ "key": "id", "value": "{{userId}}" }] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": "pm.test('Status is 200', () => pm.response.to.have.status(200));"
							}
						}
					],
					"response": []
				},
				{
					"name": "Delete User (Admin only)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/users/:id", "host": ["{{baseUrl}}"], "path": ["api", "users", ":id"], "variable": [{ "key": "id", "value": "{{userId}}" }] }
					},
					"event": [
